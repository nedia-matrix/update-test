{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NediaMatrix",
  "version": "0.8.3",
  "identifier": "com.nediamatrix.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:assets",
    "beforeBuildCommand": "pnpm build:assets",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NediaMatrix",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../../resources/desktop/logo.png",
      "../../../resources/desktop/icon.icns",
      "../../../resources/desktop/icon.ico"
    ],
    "resources": {
      "../runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    }
  }
}
