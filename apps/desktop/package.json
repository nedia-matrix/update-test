{
  "name": "@nedia-matrix/desktop",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "package:mac": "node ../../scripts/package-desktop.mjs mac",
    "package:win": "node ../../scripts/package-desktop.mjs win",
    "package:win:portable": "node ../../scripts/package-desktop.mjs win:portable",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@nedia-matrix/account-management": "workspace:*",
    "@nedia-matrix/publishing": "workspace:*",
    "@nedia-matrix/automation-engine": "workspace:*",
    "@nedia-matrix/automation-playwright": "workspace:*",
    "@nedia-matrix/diagnostics": "workspace:*",
    "@nedia-matrix/platform-sdk": "workspace:*",
    "@nedia-matrix/platform-content": "workspace:*",
    "@nedia-matrix/platform-douyin": "workspace:*",
    "@nedia-matrix/platform-kuaishou": "workspace:*",
    "@nedia-matrix/platform-xiaohongshu": "workspace:*",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@nedia-matrix/tsconfig": "workspace:*",
    "@types/node": "^26.1.2",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "catalog:",
    "vite": "^7.3.6",
    "vitest": "catalog:"
  },
  "build": {
    "appId": "com.nediamatrix.desktop",
    "productName": "NediaMatrix",
    "compression": "maximum",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/logo.png",
        "to": "logo.png"
      },
      {
        "from": "resources/mac-tray.png",
        "to": "mac-tray.png"
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-portable-${arch}.${ext}"
    }
  }
}
