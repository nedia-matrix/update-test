{
  "name": "@nedia-matrix/root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "desktop:build-dependencies": "turbo run build --filter=\"@nedia-matrix/desktop^...\"",
    "desktop:package:mac": "pnpm desktop:build-dependencies && pnpm --filter @nedia-matrix/desktop package:mac",
    "desktop:package:win": "pnpm desktop:build-dependencies && pnpm --filter @nedia-matrix/desktop package:win",
    "desktop:package:win:portable": "pnpm desktop:build-dependencies && pnpm --filter @nedia-matrix/desktop package:win:portable",
    "postinstall": "node scripts/fix-electron.mjs",
    "tauri:package": "pnpm --filter @nedia-matrix/tauri package"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "resedit": "1.7.2",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "vite": "^7.3.6",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "4.2.2"
  }
}
