{
  "name": "@nedia-matrix/root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "turbo run build",
    "browser:install": "pnpm --filter @nedia-matrix/automation-playwright exec playwright install chromium",
    "dev": "turbo run build --filter='./packages/**' && pnpm --filter @nedia-matrix/desktop dev",
    "desktop:build-dependencies": "turbo run build --filter=\"@nedia-matrix/desktop^...\"",
    "desktop:package:mac": "pnpm desktop:build-dependencies && pnpm --filter @nedia-matrix/desktop package:mac",
    "desktop:package:win": "pnpm desktop:build-dependencies && pnpm --filter @nedia-matrix/desktop package:win",
    "desktop:package:win:portable": "pnpm desktop:build-dependencies && pnpm --filter @nedia-matrix/desktop package:win:portable",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/fix-electron.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "browser:install:fingerprint": "turbo run build --filter=@nedia-matrix/automation-playwright && node packages/automation/playwright/scripts/install-fingerprint-browser.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
